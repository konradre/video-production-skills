# Copy this file to .env (gitignored) and fill in the keys for the parts of the kit you use. The scripts read keys
# from the process environment, never from this file, so load .env in the same command that needs it:
#   set -a; . ~/.claude/skills/video-production/../../.env; set +a
# That path resolves through the installer's link to the root of this repository. One KEY=value per line, no
# `export`, no quotes. A key never goes into a skill, a prompt, a receipt or a command line.

# kie.ai — stills: GPT Image 2.5 image-to-image (the default still model), Nano Banana Pro (the fallback), uploads.
#   skills/video-gen-cost-gate/scripts/gen_stills.py, kie_upload.py
KIE_API_KEY=

# fal.ai — Seedance 2.5 and MiniMax H3 for people-free shots (fal refuses photoreal people in references), and the
# hosted Topaz Starlight upscale. skills/video-gen-cost-gate/scripts/gen_video_fal.py,
# skills/video-finish-qc/scripts/upscale_fal_topaz.py
FAL_KEY=

# ElevenLabs — voice-over, dubs, voice clones, generated sfx, Scribe word times and the character balance.
#   skills/spot-audio-assembly/scripts/gen_vo.py, vo_word_times.py; skills/video-production/scripts/status_line.py
ELEVENLABS_API_KEY=

# AceDataCloud — Suno music, the default music route. No script ships for it: the agent makes the call documented in
# skills/spot-audio-assembly/references/SFX-AND-MUSIC.md § Music, with this token as the Bearer header.
ACEDATACLOUD_API_TOKEN=

# Optional — routes no script calls; set one only if you send work there by hand
# (skills/video-gen-cost-gate/references/VENUES.md):
# OPENAI_API_KEY=         the OpenAI Images API, called directly
# REPLICATE_API_TOKEN=    Replicate, a still fallback for reference sheets another venue refused

# Higgsfield has TWO surfaces and they are separate accounts with separate wallets. The CLI logs in on its own
# (`higgsfield auth login`, then `higgsfield workspace set <workspace-id>`) and needs nothing here. The REST API at
# api.higgsfield.ai takes a static key pair instead, which is what removes the CLI's short-lived-OAuth re-login; the
# two variable names below are the vendor's own, so every snippet in their docs runs verbatim. Set them only if you
# use the API. See skills/video-gen-cost-gate/references/VENUES.md for what each surface can and cannot reach.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Combined `<id>:<secret>` form -- only the official TypeScript SDK reads this one.
HF_CREDENTIALS=

# No key: monid keeps its key in its own CLI credential store (`npm install -g @monid-ai/cli`, then `monid keys add`);
# treg likewise (`treg` CLI) -- nothing to set here, and nothing for a script to read from the environment;
# every Hugging Face weight the README names downloads without a token; Freesound previews are public; ComfyUI,
# Topaz and Resolve are local installs.

# ComfyUI server for the scene-proxy route (skills/video-refs-continuity/scripts/scene_blockout.py).
# comfy_ready.py in that folder probes COMFY_HOST; comfy_up.sh beside it starts a headless server from the four lines
# below, or on another machine over ssh when COMFY_SSH is set. ComfyUI opens no browser unless told to.
COMFY_HOST=http://127.0.0.1:8188
COMFY_DIR=/path/to/ComfyUI
COMFY_VENV=/path/to/ComfyUI/venv
COMFY_ARGS=--listen 0.0.0.0 --port 8188 --disable-auto-launch
COMFY_LOG=/tmp/comfyui.log
# COMFY_SSH=user@gpu-box

# Optional — only when you run the finishing tools. Each script documents its variables in its header, and
# tools/README.md gives the defaults:
#   tools/topaz-upscale : TOPAZ_UPSCALE_PY, TOPAZ_FFMPEG, TOPAZ_OUT_DIR, TVAI_MODEL_DIR, TVAI_MODEL_DATA_DIR
#   tools/resolve-pass  : RESOLVE_PY, RESOLVE_SCRIPT_API, RESOLVE_SCRIPT_LIB, RESOLVE_SCRIPT_HOST, RESOLVE_SCRIPT_TIMEOUT,
#                         RESOLVE_PASS_DIR, RESOLVE_PASS_OUT, RESOLVE_PASS_PROJECT, RESOLVE_PASS_DISTRO,
#                         DAVINCI_RESOLVE_MCP_DIR, RESOLVE_LOOKS_EXPORT_DIR, LOOK_LIBRARY_DRX
#   video-finish-qc     : LOOK_LIBRARY_CUBES (the baked cubes; default look-library/cubes)
# The Resolve bridge keeps its HMAC token in the config its own installer writes (look-library/GUIDE.md § 5b).
